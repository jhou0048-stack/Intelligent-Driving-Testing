# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Build and packaging output
build/
dist/
*.egg-info/

# Editors and operating systems
.DS_Store
.idea/
.vscode/
*.swp

# Environment variables and local configuration
.env
.env.*
!.env.example

# Runtime artifacts (retain directory placeholders)
data/*
!data/.gitkeep
logs/*
!logs/.gitkeep
reports/*
!reports/.gitkeep

# Model weights and large generated assets
*.onnx
*.pt
*.pth
*.engine

